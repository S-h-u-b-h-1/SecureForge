# Configure a model in the local TrueForge dashboard first.
TRUEFORGE_BASE_URL=http://localhost:8790
# Use the exact provider/model identifier configured in TrueForge.
SECUREFORGE_MODEL=replace-with-configured-provider/model
# Name of a registered MCP connector pointing at http://127.0.0.1:8792/mcp
SECUREFORGE_MCP_NAME=secureforge-workspace
# Optional: use a non-default local port if needed.
SECUREFORGE_MCP_PORT=8792
# Optional for OIDC-backed deployments. Never commit real tokens.
# TRUEFORGE_TOKEN=
